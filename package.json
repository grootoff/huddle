{
  "name": "huddle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=23.6.0"
  },
  "scripts": {
    "dev": "node scripts/check-node.mjs && node server/index.ts",
    "build": "next build",
    "start": "node scripts/check-node.mjs && NODE_ENV=production node server/index.ts",
    "typecheck": "tsc --noEmit",
    "check": "node scripts/check-secure-context.mjs && tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "guest": "node scripts/guest.mjs"
  },
  "dependencies": {
    "next": "^16.3.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0"
  }
}
