# Copy to .env.local (UI) / set in your host's dashboard (backend).
# Every value is optional: with none of them set, Huddle runs as a single
# process on your LAN, which is the default and the simplest setup.

# ---------------------------------------------------------------- backend ----

# Port the Node server listens on.
PORT=4000

# Where the SQLite database and uploads live. Mount a volume here in containers.
# HUDDLE_DATA_DIR=/data

# Only needed when the UI is hosted somewhere else (Netlify, Vercel, a CDN).
# Comma-separated exact origins, no trailing slash. Never use "*": the upload
# endpoint trusts a session token passed in a header.
# HUDDLE_ALLOWED_ORIGINS=https://trademohuddle.netlify.app

# --------------------------------------------------------------------- UI ----

# Backend origin, baked into the client bundle at build time. Leave unset for a
# LAN install (the UI then talks to whatever host served the page).
# NEXT_PUBLIC_HUDDLE_SERVER=https://huddle.fly.dev
